# Database Configuration
# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database?schema=public

# Local PostgreSQL (using Docker or local install)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ginza_gaming?schema=public"

# Vercel Postgres (get from Vercel Dashboard → Storage → Your Database → Settings)
# DATABASE_URL="postgres://default:password@host.vercel-storage.com:5432/verceldb"

# Supabase (alternative free option)
# DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID (use @userinfobot or check Telegram API)
# For Ginza Public Chat: https://t.me/+tUSssIotf7QzZGRh
# Add bot to group and run: npm run get-chat-id
TELEGRAM_CHAT_ID=your_chat_id_here

# Message Timing (in minutes)
# How many minutes before an event to send the promo message
PROMO_OFFSET_MINUTES=120

# How many minutes before an event to send the reminder message
REMINDER_OFFSET_MINUTES=10

