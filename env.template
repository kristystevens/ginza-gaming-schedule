# Database Configuration
# PostgreSQL (recommended for production)
DATABASE_URL="postgresql://username:password@localhost:5432/ginza_gaming?schema=public"

# For SQLite (local development only)
# DATABASE_URL="file:./prisma/dev.db"

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID (use @userinfobot or check Telegram API)
# For Ginza Public Chat: https://t.me/+tUSssIotf7QzZGRh
# Add bot to group and run: npm run get-chat-id
TELEGRAM_CHAT_ID=your_chat_id_here

# Message Timing (in minutes)
# How many minutes before an event to send the promo message
PROMO_OFFSET_MINUTES=120

# How many minutes before an event to send the reminder message
REMINDER_OFFSET_MINUTES=10

